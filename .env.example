# copy to .env (the voice agent and the harness read it; for shell scripts use `set -a; source .env; set +a`)

# OpenAI (required): voice instruction parser and overhead-image marking (gpt-5.5)
OPENAI_API_KEY=

# Hugging Face token (optional: the openjev weights are not gated; a placeholder value would make downloads fail)
HF_TOKEN=

# rendering backend for the MuJoCo digital twin: egl (GPU) or osmesa (CPU)
MUJOCO_GL=egl

# optional: other decision-layer backends / server auth
TYPESAFE_API_KEY=
OPENJEV_API_KEY=
DJEV_API_KEY=
